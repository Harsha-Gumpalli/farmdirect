# Copy to .env (never commit it) or set these in your host's dashboard.
SESSION_SECRET=replace-with-a-long-random-string
SEED_DEMO=true
GOOGLE_MAPS_API_KEY=
# Defaults inside the Docker image; point both at a persistent volume.
DB_PATH=/data/farmdirect.db
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50

# Email notifications (optional)
RESEND_API_KEY=
EMAIL_FROM=FarmDirect <onboarding@resend.dev>
SITE_URL=https://farmdirect-production-adc2.up.railway.app
